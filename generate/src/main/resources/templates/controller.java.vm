package ${package.Controller};

#if(${swagger})
import io.swagger.annotations.Api;
import io.swagger.annotations.ApiModel;
import io.swagger.annotations.ApiOperation;
import io.swagger.annotations.ApiParam;
#end
import com.baomidou.mybatisplus.core.toolkit.StringUtils;
import com.baomidou.mybatisplus.core.metadata.OrderItem;
import com.baomidou.mybatisplus.core.conditions.query.QueryWrapper;
import com.baomidou.mybatisplus.extension.plugins.pagination.Page;
import org.springframework.web.bind.annotation.*;
import javax.annotation.Resource;
import java.util.ArrayList;
import java.util.List;
import com.zondy.land.baseparams.response.RespResult;

import $!{package.Service}.$!{table.serviceName};
import ${package.Entity}.${entity};

#if(${superControllerClassPackage})
import ${superControllerClassPackage};
#end

/**
 * <p>
 * $!{table.comment} 前端控制器Controller
 * </p>
 *
 * @author ${author}
 * @since ${date}
 */
#if(${swagger})
@Api(tags = "REST - $!{table.comment}")
#end
#if(${restControllerStyle})
@RestController
#else
@Controller
#end
@RequestMapping("#if(${package.ModuleName})/${package.ModuleName}#end/#if(${controllerMappingHyphenStyle})${controllerMappingHyphen}#else${table.entityPath}#end")
#if(${kotlin})
class ${table.controllerName}#if(${superControllerClass}) : ${superControllerClass}()#end
#else
    #if(${superControllerClass})
public class ${table.controllerName} extends ${superControllerClass} {
    #else
public class ${table.controllerName} {
    #end

    @Resource
    private ${table.serviceName} ${table.entityPath}Service;

    ## 主键类型判断
    #foreach($field in ${table.fields})
        #if(${field.keyFlag})
        ## 主键类型
            #set($idType=${field.propertyType})
        ## 主键名称
            #set($idName=${field.propertyName})
        ## 主键字段描述
            #set($idComment=${field.comment})
        ## 跳出
            #break
        #end
    #end

    @PostMapping("/save")
    #if(${swagger})
    @ApiOperation(value = "插入或更新记录")
    #end
    public RespResult saveOrUpdate(@RequestBody ${entity} ${table.entityPath}) {
        RespResult respResult = new RespResult<>();
        respResult.setMessage("成功");
        boolean bl = ${table.entityPath}Service.saveOrUpdate(${table.entityPath});
        if(bl == false){
            respResult.setCode(500);
            respResult.setMessage("保存失败");
        }
        respResult.setData(bl);
        return respResult;
    }

    @PostMapping("/getOne")
    #if(${swagger})
    @ApiOperation(value = "查询一条记录")
    #end
    public RespResult getOne(@RequestBody ${entity} ${table.entityPath}) {
        RespResult respResult = new RespResult<>();
        respResult.setMessage("成功");
        QueryWrapper<${entity}> ${table.entityPath}QueryWrapper = new QueryWrapper<>();
        ${table.entityPath}QueryWrapper.setEntity(${table.entityPath});
        ${entity} rst = ${table.entityPath}Service.getOne(${table.entityPath}QueryWrapper);
        if(rst == null){
            respResult.setCode(500);
            respResult.setMessage("查询返回值为null");
        }
        respResult.setData(rst);
        return respResult;
    }

    @PostMapping("/list")
    #if(${swagger})
    @ApiOperation(value = "精确查询多条记录")
    #end
    public RespResult list(@RequestBody ${entity} ${table.entityPath}) {
        RespResult respResult = new RespResult<>();
        respResult.setMessage("成功");
        QueryWrapper<${entity}> ${table.entityPath}QueryWrapper = new QueryWrapper<>();
        ${table.entityPath}QueryWrapper.setEntity(${table.entityPath});
        List<${entity}> rst = ${table.entityPath}Service.list(${table.entityPath}QueryWrapper);
        if(rst == null){
            respResult.setCode(500);
            respResult.setMessage("查询返回值为null");
        }
        respResult.setData(rst);
        return respResult;
    }

    @DeleteMapping("/delete/{${idName}}")
    #if(${swagger})
    @ApiOperation(value = "根据主键字段删除一行记录")
    #end
    public RespResult delete(@ApiParam(value = "${idComment}")  @PathVariable ${idType} ${idName}){
        RespResult respResult = new RespResult<>();
        respResult.setMessage("成功");
        boolean bl = ${table.entityPath}Service.removeById(${idName});
        if(bl == false){
            respResult.setCode(500);
            respResult.setMessage("删除失败");
        }
        respResult.setData(bl);
        return respResult;
    }

    @PostMapping("/page")
    #if(${swagger})
    @ApiOperation(value = "分页查询，支持多字段模糊查询，支持多字段排序")
    #end
    public RespResult findPage(@ApiParam(value = "页码") @RequestParam(defaultValue = "1") Integer pageNum,
                               @ApiParam(value = "每页多少条记录") @RequestParam(defaultValue = "10") Integer pageSize,
                               @ApiParam(value = "模糊查询字段，多个用英文逗号隔开") @RequestParam(required = false) String fuzzyField,
                               @ApiParam(value = "模糊查询的值") @RequestParam(required = false) String fuzzyValue,
                               @ApiParam(value = "排序字段，多个用英文逗号隔开") @RequestParam(required = false) String orderField,
                               @ApiParam(value = "升序/降序，asc/desc") @RequestParam(required = false) boolean asc) {
        RespResult respResult = new RespResult<>();
        respResult.setMessage("成功");
        Page page = new Page<>(pageNum, pageSize);
        if(StringUtils.isNotBlank(orderField)) {
            List<OrderItem> lstOrder = new ArrayList<>();
            String [] flds =  orderField.split(",");
            for (String fld : flds) {
                if(asc){
                    lstOrder.add(OrderItem.asc(fld));
                }else {
                    lstOrder.add(OrderItem.desc(fld));
                }
            }
            page.setOrders(lstOrder);
        }

        QueryWrapper<${entity}> ${table.entityPath}QueryWrapper = new QueryWrapper<>();
        if(StringUtils.isNotBlank(fuzzyField)) {
            String [] fuzzyflds =  fuzzyField.split(",");
            for (String fld : fuzzyflds){
                ${table.entityPath}QueryWrapper.like(fld,fuzzyValue);
            }
        }

        Page<${entity}> rst = ${table.entityPath}Service.page(page,${table.entityPath}QueryWrapper);
        if(rst == null){
            respResult.setCode(500);
            respResult.setMessage("查询返回值为null");
        }
        respResult.setData(rst);
        return respResult;
    }
}

#end
